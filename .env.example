# PEPEW Light Wallet environment example
# Copy values into apps/web/.env.local or the deployment environment when needed.

# Production usually uses same-origin API calls and does not need this variable.
# Set it only for local development or staging.
VITE_PEPEW_LIGHT_API_BASE_URL=https://light.pepepow.net

# Notes:
# - Vite variables are bundled into the browser build.
# - The wallet should call PEPEW Light routes under /api/wallet/*.
# - Server-side ElectrumX, RPC, cache, and rate-limit configuration belongs in pepepow-electrumx-service.
# - Do not place wallet recovery material or server credentials in frontend environment files.
